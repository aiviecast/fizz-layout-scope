// wasm — ブラウザの positionScope から呼ぶ。Bool/Int を Float で授受(文字列なし)。
import self as ls
import float
import int
@export(wasm, "scope_id")
fn scope_id(has_mode: Float, mode_vertical: Float, query_vertical: Float) -> Float =
  float.from(ls.scope_id(has_mode > 0.5, mode_vertical > 0.5, query_vertical > 0.5))
@export(wasm, "is_vertical")
fn is_vertical(has_mode: Float, mode_vertical: Float, query_vertical: Float) -> Float =
  if ls.is_vertical(has_mode > 0.5, mode_vertical > 0.5, query_vertical > 0.5) then 1.0 else 0.0
effect fn main() -> Unit = {
  let _a = scope_id(0.0, 0.0, 1.0)
  let _b = is_vertical(1.0, 0.0, 1.0)
  ()
}
